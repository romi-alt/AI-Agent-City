{
  "name": "@agentcity/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL migrations, connection helpers and test databases. Server-only.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../../infra/local-dev.env --import tsx src/cli-migrate.ts up",
    "migrate:down": "node --env-file-if-exists=../../infra/local-dev.env --import tsx src/cli-migrate.ts down",
    "verify-search": "node --env-file-if-exists=../../infra/local-dev.env --import tsx src/verify-search.ts",
    "test": "echo 'packages/db has integration tests only: pnpm --filter @agentcity/db test:integration'",
    "test:integration": "node --env-file-if-exists=../../infra/local-dev.env --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
