{
  "name": "agentcity",
  "private": true,
  "description": "AgentCity workspace: the legacy Sales City app plus the proposal-stack apps being migrated to (see MIGRATION-STATUS.md).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter './packages/*' run build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose.yaml --env-file infra/local-dev.env up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml --env-file infra/local-dev.env down",
    "infra:reset": "docker compose -f infra/compose.yaml --env-file infra/local-dev.env down -v",
    "infra:ps": "docker compose -f infra/compose.yaml --env-file infra/local-dev.env ps",
    "keycloak:providers": "node scripts/build-keycloak-providers.mjs",
    "keycloak:seed": "node --env-file=infra/local-dev.env infra/keycloak/seed/seed-dev-users.mjs",
    "keycloak:verify": "node --env-file=infra/local-dev.env infra/keycloak/verify/verify-idp.mjs",
    "infra:init": "pnpm db:migrate && pnpm --filter @agentcity/api run storage:init",
    "db:migrate": "pnpm --filter @agentcity/db run migrate",
    "db:verify-search": "pnpm --filter @agentcity/db run verify-search",
    "db:test": "pnpm --filter @agentcity/db --filter @agentcity/legacy-import --filter @agentcity/api run test:integration",
    "demo:expire": "pnpm --filter @agentcity/worker run demo:expire",
    "legacy:import": "pnpm --filter @agentcity/legacy-import run legacy-import",
    "legacy:rehearse-backup": "pnpm --filter @agentcity/legacy-import run rehearse:backup",
    "dev:api": "pnpm --filter @agentcity/api run dev",
    "dev:worker": "pnpm --filter @agentcity/worker run dev",
    "dev:web": "pnpm --filter @agentcity/web run dev",
    "dev:legacy": "pnpm --filter @agentcity/legacy run dev",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
