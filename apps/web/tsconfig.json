{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app", "components", "lib", "test", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
