{
  "name": "@agentcity/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js (App Router) web app. M01: a platform status page that calls the API; M03: sign-in, account, devices, tenant switching, invitations.",
  "type": "module",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "start": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=../../infra/local-dev.env ./node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1",
    "dev": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=../../infra/local-dev.env ./node_modules/next/dist/bin/next dev -p 3000 -H 127.0.0.1",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test --test-concurrency=1 test/browser.smoke.ts"
  },
  "dependencies": {
    "@agentcity/city-scene": "workspace:*",
    "@agentcity/contracts": "workspace:*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "socket.io-client": "4.8.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
