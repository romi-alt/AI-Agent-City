{
  "name": "@agentcity/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js (App Router) web app. M01: a platform status page that calls the API.",
  "type": "module",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "start": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=../../infra/local-dev.env ./node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1",
    "dev": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=../../infra/local-dev.env ./node_modules/next/dist/bin/next dev -p 3000 -H 127.0.0.1",
    "test": "echo 'apps/web is covered by the smoke check (pnpm smoke)'"
  },
  "dependencies": {
    "@agentcity/contracts": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
