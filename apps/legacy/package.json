{
  "name": "@agentcity/legacy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.180.0",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "nodemailer": "10.2.1",
    "qrcode": "1.5.4",
    "three": "0.180.0",
    "zod": "4.6.7"
  }
}
