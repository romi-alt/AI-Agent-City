{
  "name": "@agentcity/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API (REST + GraphQL + OpenAPI). M01: health/readiness and the platform heartbeat only.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../infra/local-dev.env dist/main.js",
    "dev": "pnpm run build && pnpm run start",
    "contracts": "node --env-file-if-exists=../../infra/local-dev.env dist/main.js --write-contracts",
    "test": "node --env-file-if-exists=../../infra/local-dev.env --import tsx --test test/*.test.ts",
    "storage:init": "node --env-file-if-exists=../../infra/local-dev.env --import tsx src/cli-init-storage.ts"
  },
  "dependencies": {
    "@agentcity/contracts": "workspace:*",
    "@agentcity/db": "workspace:*",
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1157.0",
    "@nestjs/apollo": "14.1.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/graphql": "14.1.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/websockets": "12.3.2",
    "@temporalio/client": "1.24.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "graphql": "16.14.2",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
