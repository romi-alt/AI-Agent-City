  "info": {
    "title": "AgentCity API",
    "description": "REST contract. GraphQL schema: generated/schema.graphql. M01 covers health only.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "alive"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ]
      },
      "DependencyCheckDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "postgres",
              "redis",
              "objectStorage",
              "temporal"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "description": "Short reason; never a connection string or credential"
          },
          "latencyMs": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "ok",
          "detail",
          "latencyMs"
        ]
      },
      "ReadinessReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not-ready"
            ]
          },
          "checkedAt": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependencyCheckDto"
            }
          }
        },
        "required": [
          "status",
          "checkedAt",
          "checks"
        ]
      }
    }
  }
}
