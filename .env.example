# Copy to .env (never commit it) or set these in your host's environment.

# Server
PORT=3001
DATA_DIR=./data                 # city state, users, sessions, sign-in log
PUBLIC_URL=                     # e.g. https://office.fastsalestrainingcenter.com (used in setup links)
COOKIE_SECURE=false             # set true when served over HTTPS
TRUST_PROXY=loopback            # set to your proxy's address / hop count behind a load balancer

# Email (daily / morning / weekly reports, emails to real leads)
SMTP_URL=                       # smtps://user:pass@smtp.example.com:465
MAIL_FROM=                      # "Fast Sales <office@example.com>"

# Text messages (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                    # +15551234567

# Claude drafting (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_DRAFTS_PER_HOUR=60
