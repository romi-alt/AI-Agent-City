{
  "realm": "agentcity",
  "displayName": "AgentCity (local development)",
  "enabled": true,
  "sslRequired": "external",
  "attributes": {
    "frontendUrl": "http://localhost:58080",
    "acr.loa.map": "{\"1\":1,\"2\":2}"
  },
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": true,
  "organizationsEnabled": false,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 900,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 604800,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "offlineSessionIdleTimeout": 86400,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 86400,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "email"],
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "smtpServer": {
    "host": "mail",
    "port": "1025",
    "from": "noreply@agentcity.local",
    "fromDisplayName": "AgentCity (local)",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "webAuthnPolicyPasswordlessRpEntityName": "AgentCity",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyPasswordlessRpId": "",
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "none",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessResidentKey": "required",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessAcceptableAaguids": [],
  "webAuthnPolicyPasswordlessPasskeysEnabled": false,
  "browserFlow": "agentcity-browser",
  "firstBrokerLoginFlow": "agentcity-first-broker-login",
  "directGrantFlow": "agentcity-deny",
  "resetCredentialsFlow": "agentcity-deny",
  "registrationFlow": "agentcity-deny",
  "dockerAuthenticationFlow": "agentcity-deny",
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Passkey Register",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "delete_credential",
      "name": "Delete Credential",
      "providerId": "delete_credential",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "idp_link",
      "name": "Linking Identity Provider",
      "providerId": "idp_link",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "update_user_locale",
      "name": "Update User Locale",
      "providerId": "update_user_locale",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": false,
      "defaultAction": false,
      "priority": 100,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": false,
      "defaultAction": false,
      "priority": 110,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": false,
      "defaultAction": false,
      "priority": 120,
      "config": {}
    },
    {
      "alias": "CONFIGURE_RECOVERY_AUTHN_CODES",
      "name": "Recovery Authentication Codes",
      "providerId": "CONFIGURE_RECOVERY_AUTHN_CODES",
      "enabled": false,
      "defaultAction": false,
      "priority": 130,
      "config": {}
    },
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": false,
      "defaultAction": false,
      "priority": 140,
      "config": {}
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": false,
      "defaultAction": false,
      "priority": 150,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": false,
      "defaultAction": false,
      "priority": 160,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "agentcity-bff",
      "name": "AgentCity API (backend-for-frontend, local development)",
      "description": "Confidential OIDC client used only by the API. Tokens never reach the browser.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-oidc-bff-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:3000/api/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/signed-out",
        "backchannel.logout.url": "http://host.docker.internal:4000/api/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "require.pushed.authorization.requests": "false",
        "exclude.session.state.from.auth.response": "false",
        "id.token.signed.response.alg": "RS256",
        "access.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["basic", "acr", "email", "profile"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "identity provider alias",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "idp",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience agentcity-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agentcity-bff",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agentcity-provisioner",
      "name": "AgentCity demo provisioner (local development)",
      "description": "Demo module service account: finds or creates demo people (no password or credential) and sends the verify-email link back to /demo/verified. Only admin role: realm-management manage-users.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-provisioner-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://localhost:3000/demo/verified*"],
      "webOrigins": [],
      "attributes": {
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "access.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-agentcity-provisioner",
      "enabled": true,
      "serviceAccountClientId": "agentcity-provisioner",
      "realmRoles": [],
      "clientRoles": { "realm-management": ["manage-users"] }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [{ "client": "agentcity-provisioner", "roles": ["manage-users"] }]
  },
  "identityProviders": [
    {
      "alias": "agency-sso",
      "displayName": "Agency SSO",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "agentcity-first-broker-login",
      "postBrokerLoginFlowAlias": "agentcity-post-broker-login",
      "config": {
        "issuer": "http://localhost:58080/realms/agency-idp",
        "authorizationUrl": "http://localhost:58080/realms/agency-idp/protocol/openid-connect/auth",
        "logoutUrl": "http://localhost:58080/realms/agency-idp/protocol/openid-connect/logout",
        "tokenUrl": "http://localhost:8080/realms/agency-idp/protocol/openid-connect/token",
        "userInfoUrl": "http://localhost:8080/realms/agency-idp/protocol/openid-connect/userinfo",
        "jwksUrl": "http://localhost:8080/realms/agency-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "agentcity-broker",
        "clientSecret": "local-dev-only-agency-broker-secret",
        "clientAuthMethod": "client_secret_post",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "backchannelSupported": "true",
        "sendIdTokenOnLogout": "true",
        "sendClientIdOnLogout": "false",
        "disableUserInfo": "false",
        "disableNonce": "false",
        "allowedClockSkew": "30",
        "loginHint": "false",
        "uiLocales": "false",
        "acceptsPromptNoneForwardFromClient": "false",
        "guiOrder": "1",
        "caseSensitiveOriginalUsername": "false"
      }
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "agentcity-loa1-condition",
      "config": { "loa-condition-level": "1", "loa-max-age": "43200" }
    },
    {
      "alias": "agentcity-loa2-condition",
      "config": { "loa-condition-level": "2", "loa-max-age": "0" }
    },
    {
      "alias": "agentcity-amr-passkey",
      "config": { "default.reference.value": "passkey", "default.reference.maxAge": "43200" }
    },
    {
      "alias": "agentcity-amr-passkey-step-up",
      "config": { "default.reference.value": "passkey", "default.reference.maxAge": "43200" }
    },
    {
      "alias": "agentcity-amr-sso",
      "config": { "default.reference.value": "sso", "default.reference.maxAge": "43200" }
    },
    {
      "alias": "agentcity-passkey-not-used-yet",
      "config": { "credentials": "webauthn-passwordless", "included": "false" }
    },
    {
      "alias": "agentcity-passkey-used",
      "config": { "credentials": "webauthn-passwordless", "included": "true" }
    },
    {
      "alias": "agentcity-passkey-not-used",
      "config": { "credentials": "webauthn-passwordless", "included": "false" }
    },
    {
      "alias": "agentcity-step-up-needs-passkey",
      "config": { "denyErrorMessage": "A passkey is required for this action. Add a passkey to your account first." }
    },
    {
      "alias": "agentcity-post-broker-loa1-condition",
      "config": { "loa-condition-level": "1", "loa-max-age": "43200" }
    },
    {
      "alias": "agentcity-post-broker-loa2-condition",
      "config": { "loa-condition-level": "2", "loa-max-age": "0" }
    },
    {
      "alias": "agentcity-step-up-not-via-sso",
      "config": { "denyErrorMessage": "Agency SSO cannot confirm this action. Sign in with your passkey instead." }
    },
    {
      "alias": "agentcity-review-profile",
      "config": { "update.profile.on.first.login": "missing" }
    },
    {
      "alias": "agentcity-create-unique-user",
      "config": { "require.password.update.after.registration": "false" }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "agentcity-browser",
      "description": "Passwordless sign-in: existing session, agency SSO hint, or identify then passkey / email code. Levels: 1 basic, 2 passkey.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-browser-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-browser-forms",
      "description": "Identify the person (email), then the methods required by the requested level of authentication.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-loa1",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-loa2",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-loa1",
      "description": "Level 1 (acr 1): a passkey or an email sign-in code. The email-code execution is added by infra/keycloak/seed/email-code-step.mjs once the provider is installed.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "agentcity-loa1-condition",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorConfig": "agentcity-amr-passkey",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-loa2",
      "description": "Level 2 (acr 2): a passkey. Never offers passkey registration here; a person without a passkey is denied.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "agentcity-loa2-condition",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-loa2-passkey",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-loa2-passkey-used",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-loa2-no-passkey",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 40,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-loa2-passkey",
      "description": "Runs when the person has a passkey and has not just used it in this authentication.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "agentcity-passkey-not-used-yet",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorConfig": "agentcity-amr-passkey-step-up",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-loa2-passkey-used",
      "description": "A passkey was used in this authentication (at level 1 or just above): level 2 is satisfied. Keycloak rejects a level whose subflows all skip, so this branch must execute something.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "agentcity-passkey-used",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "allow-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-loa2-no-passkey",
      "description": "Denies level 2 when no passkey was used in this authentication (the person has none).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "agentcity-passkey-not-used",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "agentcity-step-up-needs-passkey",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-first-broker-login",
      "description": "First agency SSO sign-in: create the account if the email is unused; an existing account is linked only after the person confirms and proves the mailbox by email.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "authenticatorConfig": "agentcity-review-profile",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-first-broker-create-or-link",
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-first-broker-create-or-link",
      "description": "Create a new account, or link an existing one after confirmation and email proof.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorConfig": "agentcity-create-unique-user",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-first-broker-existing-account",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-first-broker-existing-account",
      "description": "An account with this email exists: the person confirms, then proves control of that account's mailbox.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-confirm-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-email-verification",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "agentcity-post-broker-login",
      "description": "Runs after every agency SSO sign-in. Records amr 'sso'; refuses to complete a level-2 (step-up) request, which only a passkey satisfies.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "allow-access-authenticator",
          "authenticatorConfig": "agentcity-amr-sso",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "agentcity-post-broker-loa1",
          "authenticatorFlow": true,
