# LOCAL DEVELOPMENT ONLY. These values are public, committed on purpose, and must never be used anywhere else.
# The API and worker refuse to start with NODE_ENV=production while any of them is in use (see apps/*/src/env.ts).
# Host ports are bound to 127.0.0.1 only.
COMPOSE_PROJECT_NAME=agentcity
PG_PORT=55432
POSTGRES_ADMIN_USER=agentcity_admin
POSTGRES_ADMIN_PASSWORD=local-dev-only-pg-admin
APP_DB_USER=agentcity_app
APP_DB_PASSWORD=local-dev-only-pg-app
POSTGRES_DB=agentcity
REDIS_PORT=56379
REDIS_PASSWORD=local-dev-only-redis
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_ACCESS_KEY=localdevonlyaccess
S3_SECRET_KEY=local-dev-only-s3-secret
S3_BUCKET=agentcity-dev
TEMPORAL_PORT=57233
TEMPORAL_UI_PORT=58233
KEYCLOAK_PORT=58080
KEYCLOAK_MGMT_PORT=59900
KEYCLOAK_ADMIN_USER=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-keycloak
MAIL_UI_PORT=58025

# Connection settings for the API, worker, web app and scripts (same local-only values as above).
DATABASE_ADMIN_URL=postgres://agentcity_admin:local-dev-only-pg-admin@127.0.0.1:55432/agentcity
DATABASE_URL=postgres://agentcity_app:local-dev-only-pg-app@127.0.0.1:55432/agentcity
REDIS_URL=redis://:local-dev-only-redis@127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
TEMPORAL_ADDRESS=127.0.0.1:57233
TEMPORAL_NAMESPACE=default
OIDC_ISSUER=http://localhost:58080/realms/agentcity
API_PORT=4000
API_URL=http://127.0.0.1:4000
WEB_PORT=3000

# Identity (M03). The browser uses http://localhost:3000; the web app proxies /api/* to the API, so the session
# cookie is first-party. The BFF client secret is local-only, like every secret in this file.
PUBLIC_ORIGIN=http://localhost:3000
OIDC_CLIENT_ID=agentcity-bff
OIDC_CLIENT_SECRET=local-dev-only-oidc-bff-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signed-out
SESSION_ENCRYPTION_KEY=local-dev-only-session-encryption-key
COOKIE_SECURE=false
MAIL_API_URL=http://127.0.0.1:58025
